{
  "name": "web",
  "private": true,
  "version": "2.4.0",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --config vite.config.sandbox.js && vite build --config vite.config.slides.js && node -e \"const v=require('./package.json').version; require('fs').copyFileSync('node_modules/@tailwindcss/browser/dist/index.global.js', 'dist/'+v+'/tailwind-browser.js')\"",
    "lint:deps": "npm --prefix lint-tool install",
    "lint": "npm run lint:deps && node lint-tool/node_modules/eslint/bin/eslint.js --config lint-tool/eslint.config.js .",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
