    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.3.0",
    "@tailwindcss/browser": "^4.3.3",
    "@uiw/react-codemirror": "^4.25.12",
    "@xterm/addon-fit": "^0.11.0",
